# Optional overrides for the bundled API. The dev proxy needs no configuration.
#
# Absolute API origin when the frontend is deployed separately from server/index.js.
# Leave empty to use the same origin (the default for `npm run dev` and `npm start`).
VITE_API_URL=

# Port used by `node server/index.js` when --port is not passed.
API_PORT=3101
